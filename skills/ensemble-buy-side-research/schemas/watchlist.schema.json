{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watchlist",
  "type": "object",
  "required": ["schema_version", "generated_at", "items"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variable",
          "why_it_matters",
          "source",
          "frequency",
          "bullish_signal",
          "bearish_signal"
        ],
        "properties": {
          "thesis_driver": {"type": ["string", "null"]},
          "variable": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "source": {"type": "string"},
          "frequency": {"type": "string"},
          "bullish_signal": {"type": "string"},
          "bearish_signal": {"type": "string"},
          "current_reading": {"type": ["string", "null"]},
          "next_check": {"type": ["string", "null"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]}
        }
      }
    },
    "status_rules": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
