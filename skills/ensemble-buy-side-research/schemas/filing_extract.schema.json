{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilingExtract",
  "type": "object",
  "required": ["schema_version", "generated_at", "filings"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "filings": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"$ref": "source.schema.json"}},
    "errors": {"type": "array", "items": {"$ref": "error.schema.json"}}
  }
}
