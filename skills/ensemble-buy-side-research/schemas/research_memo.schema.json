{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchMemo",
  "type": "object",
  "required": [
    "direction",
    "trigger",
    "problem_solved",
    "value_chain",
    "profit_pool",
    "buffett_quality_lens",
    "market_consensus",
    "variant_view",
    "key_variables",
    "initial_judgment",
    "falsification_conditions"
  ],
  "properties": {
    "direction": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "why_now": {
          "type": "string"
        },
        "real_variable_changed": {
          "type": "string"
        }
      }
    },
    "problem_solved": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "value_chain": {
      "$ref": "value_chain.schema.json"
    },
    "profit_pool": {
      "type": "object",
      "properties": {
        "highest_quality_layer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commoditization_risk": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "market_consensus": {
      "type": "string"
    },
    "variant_view": {
      "type": "string"
    },
    "key_variables": {
      "$ref": "watchlist.schema.json"
    },
    "initial_judgment": {
      "type": "string",
      "enum": [
        "A. Discard",
        "B. Watch",
        "C. Deep Dive",
        "D. Potential Investment Thesis"
      ]
    },
    "falsification_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_research_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buffett_quality_lens": {
      "type": "object",
      "properties": {
        "circle_of_competence": {
          "type": "string"
        },
        "business_quality": {
          "type": "string"
        },
        "moat_source": {
          "type": "string"
        },
        "moat_trend": {
          "type": "string"
        },
        "pricing_power": {
          "type": "string"
        },
        "capital_intensity": {
          "type": "string"
        },
        "management_capital_allocation": {
          "type": "string"
        },
        "five_year_market_closure_test": {
          "type": "string"
        },
        "downside_or_ruin_risk": {
          "type": "string"
        },
        "implication": {
          "type": "string"
        },
        "evidence_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
