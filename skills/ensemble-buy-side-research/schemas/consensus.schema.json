{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consensus",
  "type": "object",
  "required": ["schema_version", "generated_at", "consensus", "confidence"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "consensus": {"type": "string"},
    "crowded_layers": {"type": "array", "items": {"type": "string"}},
    "obvious_beneficiaries": {"type": "array", "items": {"type": "string"}},
    "possible_blind_spots": {"type": "array", "items": {"type": "string"}},
    "repeated_narratives": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]}
  }
}
