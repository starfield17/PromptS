{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuredError",
  "type": "object",
  "required": ["status", "module", "message", "recoverable"],
  "properties": {
    "status": {"const": "error"},
    "module": {"type": "string"},
    "message": {"type": "string"},
    "recoverable": {"type": "boolean"},
    "missing_inputs": {"type": "array", "items": {"type": "string"}}
  }
}
