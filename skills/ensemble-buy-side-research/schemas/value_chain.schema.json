{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValueChain",
  "type": "object",
  "required": [
    "direction",
    "layers"
  ],
  "properties": {
    "direction": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "problem_solved",
          "players",
          "profit_pool_quality",
          "commoditization_risk",
          "judgment"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "problem_solved": {
            "type": "string"
          },
          "players": {
            "type": "object",
            "properties": {
              "global": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "regional": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "bottleneck_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "profit_pool_quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "competition_intensity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "commoditization_risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "judgment": {
            "type": "string"
          },
          "evidence_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
