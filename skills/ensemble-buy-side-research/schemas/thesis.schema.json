{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thesis",
  "type": "object",
  "required": [
    "statement",
    "consensus",
    "variant_view",
    "layer",
    "variables",
    "falsification",
    "judgment"
  ],
  "properties": {
    "statement": {
      "type": "string"
    },
    "consensus": {
      "type": "string"
    },
    "variant_view": {
      "type": "string"
    },
    "layer": {
      "type": "string"
    },
    "time_horizon": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "judgment": {
      "type": "string",
      "enum": [
        "A. Discard",
        "B. Watch",
        "C. Deep Dive",
        "D. Potential Investment Thesis"
      ]
    },
    "next_action": {
      "type": "string"
    },
    "buffett_quality_lens": {
      "type": "object",
      "properties": {
        "circle_of_competence": {
          "type": "string"
        },
        "business_quality": {
          "type": "string"
        },
        "moat_source": {
          "type": "string"
        },
        "moat_trend": {
          "type": "string"
        },
        "pricing_power": {
          "type": "string"
        },
        "capital_intensity": {
          "type": "string"
        },
        "management_capital_allocation": {
          "type": "string"
        },
        "five_year_market_closure_test": {
          "type": "string"
        },
        "downside_or_ruin_risk": {
          "type": "string"
        },
        "implication": {
          "type": "string"
        },
        "evidence_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
